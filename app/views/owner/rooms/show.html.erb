<h1><%= @room.name %></h1>
<p><%= @room.location %></p>
<p><%= @room.price_per_hour %> ₽/час | Активно: <%= @room.is_active %></p>
<%= link_to "Редактировать", edit_owner_room_path(@room), class: "btn" %>

<h2>Бронирования</h2>
<table>
  <thead>
    <tr><th>Клиент</th><th>Начало</th><th>Конец</th><th>Статус</th></tr>
  </thead>
  <tbody>
    <% @bookings.each do |b| %>
      <tr>
        <td><%= b.user.email %></td>
        <td><%= l(b.start_time, format: :short) %></td>
        <td><%= l(b.end_time, format: :short) %></td>
        <td><%= b.status %></td>
      </tr>
    <% end %>
  </tbody>
</table>